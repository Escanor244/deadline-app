# ========================================================
# KAIROS STUDIO // ENVIRONMENT CONFIGURATION
# ========================================================
# NOTE: ALL variables below are 100% OPTIONAL!
# If you leave this file empty or do not configure environment
# variables, Kairos will run in Zero-Config mode using browser
# LocalStorage + JSON Export/Import + URL State Sharing.
# ========================================================

# --------------------------------------------------------
# 1. MONGODB ATLAS CLOUD PERSISTENCE (Optional)
# --------------------------------------------------------
# To enable multi-device cloud persistence and sync across
# phones, tablets, and laptops:
# 1. Create a free M0 cluster at https://www.mongodb.com/atlas
# 2. Add your connection string below:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority

# Name of the database (defaults to "kairos_studio" if omitted)
MONGODB_DB=kairos_studio


# --------------------------------------------------------
# 2. UNIVERSAL AI ENGINE (Optional)
# --------------------------------------------------------
# Kairos features a Universal AI Adapter. You can use ANY ONE
# of the following providers — the system auto-detects it!
# Kept strictly secure on the server, never exposed to users.

# OPTION A: Groq (Ultra-fast Llama 3.3 70B, free at https://console.groq.com)
GROQ_API_KEY=gsk_YourGroqApiKeyHere

# OPTION B: OpenRouter (Access to all models at https://openrouter.ai)
OPENROUTER_API_KEY=sk-or-v1-YourOpenRouterKeyHere

# OPTION C: Google Gemini (Free at https://aistudio.google.com)
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# OPTION D: OpenAI
OPENAI_API_KEY=sk-YourOpenAiKeyHere

# (Optional) Override model or base URL:
# AI_MODEL=llama-3.3-70b-versatile
# AI_BASE_URL=https://api.groq.com/openai/v1


# --------------------------------------------------------
# 3. APPLICATION URL (Optional, for SEO & Share Links)
# --------------------------------------------------------
# Set to your production Vercel domain once deployed:
NEXT_PUBLIC_APP_URL=https://your-project.vercel.app
